{
  "name": "synopsis_tile_workflow",
  "version": "1.0",
  "nodes": {
    "1": {
      "inputs": {
        "ckpt_name": "z_image_turbo.safetensors"
      },
      "class_type": "CheckpointLoaderSimple"
    },
    "2": {
      "inputs": {
        "text": "STYLE LOCK: crisp square pixel art tile, seamless repeatable texture, low horizon, Gulf of Finland campus style, birch pine granite grass paving",
        "clip": ["1", 1]
      },
      "class_type": "CLIPTextEncode"
    },
    "3": {
      "inputs": {
        "text": "blurry, anti-aliased, 3d render, photo, noise, text, watermark, mountains",
        "clip": ["1", 1]
      },
      "class_type": "CLIPTextEncode"
    },
    "4": {
      "inputs": {
        "width": 512,
        "height": 512,
        "batch_size": 1
      },
      "class_type": "EmptyLatentImage"
    },
    "5": {
      "inputs": {
        "seed": 26063,
        "steps": 8,
        "cfg": 2.0,
        "sampler_name": "euler",
        "scheduler": "simple",
        "denoise": 1.0,
        "model": ["1", 0],
        "positive": ["2", 0],
        "negative": ["3", 0],
        "latent_image": ["4", 0]
      },
      "class_type": "KSampler"
    },
    "6": {
      "inputs": {
        "samples": ["5", 0],
        "vae": ["1", 2]
      },
      "class_type": "VAEDecode"
    },
    "7": {
      "inputs": {
        "filename_prefix": "tile_candidate",
        "images": ["6", 0]
      },
      "class_type": "SaveImage"
    }
  }
}
